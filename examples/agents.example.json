{
  "idleTimeout": "30m",
  "agents": [
    {
      "name": "claude",
      "command": "npx",
      "args": ["-y", "@agentclientprotocol/claude-agent-acp"],
      "profile": { "instructionsVia": "meta", "skillsDir": ".claude/skills" }
    },
    {
      "name": "codex",
      "command": "npx",
      "args": ["-y", "@agentclientprotocol/codex-acp"],
      "profile": { "instructionsVia": "file:AGENTS.md", "skillsDir": ".agents/skills" }
    },
    {
      "name": "gemini",
      "command": "gemini",
      "args": ["--acp"]
    },
    {
      "name": "qwen",
      "command": "qwen",
      "args": ["--acp"]
    },
    {
      "name": "opencode",
      "command": "opencode",
      "args": ["acp", "--print-logs", "--log-level", "WARN"],
      "permissions": { "allow": ["read", "search", "think", "edit", "delete", "move", "execute"] },
      "sandbox": "opencode",
      "profile": { "instructionsVia": "file:AGENTS.md", "skillsDir": ".opencode/skills", "mcp": true },
      "stderrActivity": [
        { "match": "message=\"stream error\".*(?i)(rate limit|too many requests|: 429\\))",
          "title": "Waiting for the model: rate-limited, the agent retries on its own" },
        { "match": "message=\"stream error\"", "title": "The model call failed; the agent retries if it can" }
      ]
    }
  ]
}
